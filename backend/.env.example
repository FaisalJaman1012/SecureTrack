# Copy to backend/.env and fill in real values, or just run:  npm run gen-secrets
# backend/.env is git-ignored and must never be committed.

NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Minimum 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Exact origin(s) users browse to, comma separated. No trailing slash.
ALLOWED_ORIGINS=https://securetrack.company.local

# Only applied when the database file is created for the very first time.
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@securetrack.local

# Requests per 15 minutes per client IP.
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=10

# Reverse proxies in front of the app (IIS/nginx = 1, direct exposure = 0).
TRUST_PROXY_HOPS=1
