# Build-time settings for the React client. Committed on purpose.
#
# NEVER PUT SECRETS IN THIS FILE. Create React App inlines every REACT_APP_*
# value into the JavaScript bundle that is downloaded by every browser, so
# anything added here is public. Server-side configuration and secrets belong
# in backend/.env, which is git-ignored.

# Source maps are disabled so production JS cannot be trivially reversed.
GENERATE_SOURCEMAP=false

# Do not fail the production build on lint warnings.
CI=false
