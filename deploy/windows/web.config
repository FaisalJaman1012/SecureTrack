<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS reverse-proxy configuration for SecureTrack.

  Copy this file to the IIS site root (typically C:\inetpub\wwwroot\web.config)
  AFTER installing:
    - URL Rewrite 2.1
    - Application Request Routing 3.0  (with "Enable proxy" ticked)

  It forwards everything to the Node service on localhost:5000, forces HTTPS,
  and blocks any request path that could reach source control metadata or a
  secret file. The Node app never serves those paths anyway - this is a second
  layer in case IIS is ever pointed at the application folder directly.

  Update the two placeholder host names before use.
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>

        <!-- Block dotted paths outright: /.git/..., /.env, /backend/.env -->
        <rule name="Block dotfiles and secrets" stopProcessing="true">
          <match url="(^|/)\.(git|env|gitignore|vscode|idea)(/|$)" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found"
                  statusDescription="Not Found" />
        </rule>

        <!-- Block anything that walks into server-side folders -->
        <rule name="Block server paths" stopProcessing="true">
          <match url="^(backend|deploy|logs|backups|node_modules)(/|$)" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found"
                  statusDescription="Not Found" />
        </rule>

        <!-- Redirect plain HTTP to HTTPS -->
        <rule name="Force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Everything else goes to the Node service -->
        <rule name="Reverse proxy to SecureTrack" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:5000/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>

      </rules>

      <outboundRules>
        <!-- Rewrite Location headers so redirects keep the public host name -->
        <rule name="Fix redirect host" preCondition="IsRedirect">
          <match serverVariable="RESPONSE_Location" pattern="^http://localhost:5000/(.*)" />
          <action type="Rewrite" value="https://{HTTP_HOST}/{R:1}" />
        </rule>
        <preConditions>
          <preCondition name="IsRedirect">
            <add input="{RESPONSE_STATUS}" pattern="3\d\d" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>

    <!-- Belt and braces: refuse to serve these even if a rewrite rule is removed -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment=".git" />
          <add segment=".env" />
          <add segment="backend" />
          <add segment="deploy" />
          <add segment="logs" />
          <add segment="backups" />
          <add segment="node_modules" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".db" allowed="false" />
          <add fileExtension=".env" allowed="false" />
        </fileExtensions>
        <!-- Attachment uploads are capped at 20 MB by the app; allow 32 MB here -->
        <requestLimits maxAllowedContentLength="33554432" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <!-- Do not advertise the server stack -->
        <remove name="X-Powered-By" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
      </customHeaders>
    </httpProtocol>

    <directoryBrowse enabled="false" />

  </system.webServer>
</configuration>
